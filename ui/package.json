{
  "name": "anvil-board",
  "version": "0.2.1",
  "description": "The anvil web board: an Angular app built into ../ui-dist and served by `anvil serve`.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/normalize-eol.ts",
    "test": "ng test --watch=false",
    "lint": "eslint --flag unstable_native_nodejs_ts_config src",
    "typecheck": "tsc -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
