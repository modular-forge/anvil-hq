{
  "name": "anvil-hq",
  "version": "0.2.0",
  "description": "Local, dependency-free personal project manager: items in Markdown and JSON files, history in git, a local web board and Claude Code integration.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "anvil": "bin/anvil.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "validate:examples": "node bin/anvil.ts validate --data examples",
    "leaks": "node scripts/check-leaks.ts --all",
    "hooks": "git config core.hooksPath .githooks",
    "check": "npm run typecheck && npm test && npm run validate:examples && npm run leaks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modular-forge/anvil-hq.git"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
